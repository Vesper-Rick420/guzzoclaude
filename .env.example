# Plantilla de variables de entorno de GUZZO.
# Copia este archivo como ".env.local" y rellena tus credenciales.
# Se encuentran en: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# Clave SECRETA - solo servidor, nunca se expone al navegador.
# Necesaria para operaciones de admin (eliminar usuarios).
SUPABASE_SERVICE_ROLE_KEY=tu-clave-secreta
